# 环境配置文件
# 复制为 .env 并根据实际环境修改

# 应用配置
DEBUG=true
APP_NAME="视频处理任务系统"
APP_VERSION="1.0.0"

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 日志配置
LOG_LEVEL=INFO

# 任务配置
TASK_TIMEOUT=3600
MAX_RETRIES=3
MAX_FILE_SIZE=50
